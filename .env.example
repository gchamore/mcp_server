# ---------------------------------------------------------------------------
# MCP Wesype — variables d'environnement
# Copier vers .env et compléter. Toutes les variables sont validées au démarrage
# par src/core/env.ts : une valeur manquante ou invalide arrête le serveur.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# URL publique du serveur, absolue (http:// ou https://). Sert à construire les
# URLs MCP remises aux utilisateurs et le callback OAuth.
# Sur Railway, RAILWAY_PUBLIC_DOMAIN prend le relais si cette variable est absente.
# `BASE_URL` reste accepté par compatibilité, mais préférez APP_BASE_URL : le nom
# `BASE_URL` est déjà utilisé par certains outils de build (Vite) avec la valeur « / ».
APP_BASE_URL=http://localhost:3000

# Origines autorisées pour le front (séparées par des virgules).
# En dev, l'origine du serveur Vite doit y figurer.
CORS_ORIGINS=http://localhost:5173

# --- Base de données -------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/mcp_wesype

# --- Secrets ---------------------------------------------------------------
# 64 caractères hexadécimaux (32 octets). Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Pendant une rotation de clé uniquement : les anciennes clés, séparées par des
# virgules, le temps de lancer `npm run rotate:encryption`. Retirer ensuite.
ENCRYPTION_KEY_PREVIOUS=
# Idem, sert à signer les cookies et l'état OAuth.
SESSION_SECRET=

# --- Google OAuth (optionnel) ----------------------------------------------
# Sert à DEUX usages :
#   1. la connexion « Continuer avec Google » sur le site ;
#   2. le connecteur Gmail (couche B), via le préfixe GOOGLE_.
# Laisser vide désactive les deux, sans faire échouer le démarrage.
#
# Pour le connecteur Gmail, l'application doit en plus : avoir l'API Gmail
# activée, déclarer les scopes Gmail sur l'écran de consentement, et autoriser
# l'URI de redirection <APP_BASE_URL>/api/connections/oauth/gmail/callback
# (voir docs/oauth.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Applications OAuth des autres connecteurs -----------------------------
# Un connecteur OAuth déclare un préfixe (`credentialsEnvPrefix`) et lit
# <PREFIX>_CLIENT_ID / <PREFIX>_CLIENT_SECRET. Exemple pour un futur Notion :
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=

# --- E-mail (optionnel, requis pour la réinitialisation de mot de passe) ----
# Laisser SMTP_HOST vide pour désactiver l'envoi d'e-mails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="MCP Wesype <no-reply@wesype.com>"

# --- Journalisation --------------------------------------------------------
LOG_LEVEL=info
