{
  "name": "mcp-wesype-server",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "NODE_OPTIONS='--max-old-space-size=1024' tsc",
    "build:production": "NODE_OPTIONS='--max-old-space-size=1024' tsc --incremental false",
    "serve": "node dist/server.js",
    "clean": "rm -rf dist",
    "build:clean": "npm run clean && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.4",
    "@prisma/client": "^6.15.0",
    "abort-controller": "^3.0.0",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^3.3.2",
    "prisma": "^6.15.0",
    "uuid": "^11.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.0",
    "@types/node-fetch": "^2.6.13",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.1",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  }
}
