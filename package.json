{
  "name": "gmail-mcp-server-ts",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "NODE_OPTIONS='--max-old-space-size=1024' tsc",
    "build:production": "NODE_OPTIONS='--max-old-space-size=1024' tsc --incremental false",
    "postinstall": "echo 'Using pre-compiled dist/ files for production'",
    "serve": "node dist/src/server.js",
    "test": "node test-local.cjs",
    "test:railway": "node test-railway.cjs",
    "validate": "node validate-deployment.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "google-auth-library": "^9.4.1",
    "googleapis": "^128.0.0",
    "uuid": "^11.1.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.1",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  }
}
