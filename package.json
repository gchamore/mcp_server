{
  "name": "mcp-wesype-server",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "start:n8n": "n8n start",
    "start:all": "concurrently \"npm run start\" \"npm run start:n8n\"",
    "dev": "tsx watch src/server.ts",
    "build": "NODE_OPTIONS='--max-old-space-size=1024' tsc",
    "build:production": "NODE_OPTIONS='--max-old-space-size=1024' tsc --incremental false",
    "serve": "node dist/server.js",
    "clean": "rm -rf dist",
    "build:clean": "npm run clean && npm run build"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "bcryptjs": "^3.0.2",
    "concurrently": "^8.2.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "n8n": "^1.0.0",
    "prisma": "^6.15.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.0",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.1",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  }
}
